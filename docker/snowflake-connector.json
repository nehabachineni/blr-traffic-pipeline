{
  "name": "snowflake-sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeSinkConnector",
    "tasks.max": "1",

    "topics": "traffic.raw.events",

    "snowflake.url.name": "${env:SNOWFLAKE_ACCOUNT}",
    "snowflake.user.name": "${env:SNOWFLAKE_USER}",
    "snowflake.private.key": "${env:SNOWFLAKE_PRIVATE_KEY}",

    "snowflake.database.name": "TRAFFIC_PIPELINE",
    "snowflake.schema.name": "BRONZE",
    "snowflake.table.name": "TRAFFIC_RAW",

   "errors.tolerance": "all",
   "errors.deadletterqueue.topic.name": "traffic.dlq.connect",
   "errors.deadletterqueue.topic.replication.factor": "1",
   "errors.log.enable": "true",
   "errors.log.include.messages": "true",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter.schemas.enable": "false",
    "buffer.count.records": "100",
    "buffer.flush.time": "30"
  }
}

